                                    "});",
                                    "pm.test('Obtiene tokens JWT y guarda user1_token', function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('access');",
                                    "    pm.collectionVariables.set('user1_token', jsonData.access);",
